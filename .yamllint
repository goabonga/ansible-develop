---
extends: default
ignore: |
  .ansible/
  .github/
rules:
  # The values ansible-lint requires of a custom yamllint configuration.
  comments:
    min-spaces-from-content: 1
  comments-indentation: false
  braces:
    max-spaces-inside: 1
  octal-values:
    forbid-implicit-octal: true
    forbid-explicit-octal: true
  line-length:
    max: 120
  truthy:
    allowed-values: ["true", "false"]
    check-keys: false
